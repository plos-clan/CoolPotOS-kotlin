#!/usr/bin/bash
set -euo pipefail

mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
mount -t proc -o nosuid,nodev,noexec proc /proc
mount -t sysfs -o nosuid,nodev,noexec sysfs /sys

readonly lower=/run/lower
readonly merged=/run/root
mkdir -p "$lower" "$merged"
mount --bind / "$lower"

source=
for argument in $(cat /proc/cmdline); do
    case "$argument" in
        overlay=PARTUUID=*) source=/dev/disk/by-partuuid/${argument#overlay=PARTUUID=} ;;
    esac
done
[ -n "$source" ]
timeout 30 bash -c 'until test -b "$1"; do sleep 0.1; done' bash "$source"

status=0
e2fsck -p "$source" || status=$?
[ "$status" -le 1 ]
fuse2fs -o rw,allow_other "$source" /overlay
mkdir -p /overlay/upper /overlay/work /overlay/results
fuse-overlayfs -o "lowerdir=$lower,upperdir=/overlay/upper,workdir=/overlay/work" "$merged"
mkdir -p "$merged"/{dev,proc,sys,run,overlay}
for name in dev proc sys run overlay; do
    mount --bind "/$name" "$merged/$name"
done
exec chroot "$merged" /usr/lib/systemd/systemd
