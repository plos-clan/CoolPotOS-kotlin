#!/usr/bin/bash
set -euo pipefail

readonly overlay_state=/run/fuse-overlayfs
readonly overlay_lower=$overlay_state/lower
readonly overlay_root=/run/root

printf 'init: preparing overlay layers\n'
mount -t tmpfs -o mode=0700,nosuid,nodev tmpfs /run
mount -t proc -o nosuid,nodev,noexec proc /proc
mkdir -p "$overlay_lower" "$overlay_state/upper" "$overlay_state/work" "$overlay_root"
mount --bind / "$overlay_lower"

printf 'init: starting fuse-overlayfs\n'
fuse-overlayfs \
    -o "lowerdir=$overlay_lower,upperdir=$overlay_state/upper,workdir=$overlay_state/work" \
    "$overlay_root"

printf 'init: mounting runtime filesystems\n'
mkdir -p "$overlay_root"/{dev,proc,sys,run}
mount -t proc -o nosuid,nodev,noexec proc "$overlay_root/proc"
mount -t sysfs -o nosuid,nodev,noexec sysfs "$overlay_root/sys"
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs "$overlay_root/run"
mount --move /dev "$overlay_root/dev"

printf 'init: starting network service\n'
install -d -m 0700 "$overlay_root/etc/NetworkManager/system-connections"
install -d -m 0755 "$overlay_root/run/dbus"

cat > "$overlay_root/etc/NetworkManager/system-connections/eth0.nmconnection" <<'EOF'
[connection]
id=cpos-eth0
uuid=4d89bc6c-2f46-43a1-b721-45a2d65a9b3d
type=ethernet
interface-name=eth0
autoconnect=true

[ipv4]
method=manual
addresses1=10.0.2.15/24,10.0.2.2
dns=10.0.2.3;

[ipv6]
method=disabled
EOF

chmod 600 "$overlay_root/etc/NetworkManager/system-connections/eth0.nmconnection"

chroot "$overlay_root" /usr/bin/dbus-daemon --system --fork --nopidfile
chroot "$overlay_root" /usr/bin/NetworkManager --no-daemon \
>"$overlay_root/run/NetworkManager.log" 2>&1 &

printf 'init: mounted fuse-overlayfs root\n'
exec chroot "$overlay_root" /usr/bin/bash
