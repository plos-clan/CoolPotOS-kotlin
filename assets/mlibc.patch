+int Sysdeps<ClockGet>::operator()(int clock, time_t *secs, long *nanos) {
+	if(!secs || !nanos)
+		return EINVAL;
+
+	struct timespec tp = {};
+	int error = vdso_clock_gettime
+		? -vdso_clock_gettime(clock, &tp)
+		: sc_error(::syscall(SYS_clock_gettime, clock, &tp));
+	if(error)
+		return error;
+
+	*secs = tp.tv_sec;
+	*nanos = tp.tv_nsec;
+	return 0;
+}
