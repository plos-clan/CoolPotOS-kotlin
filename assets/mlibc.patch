+	else if(fsfdt == fsfd_target::fd)
+		flags |= AT_EMPTY_PATH;
+	else
+		__ensure(fsfdt == fsfd_target::fd_path);
+
+#if defined(SYS_newfstatat)
+	auto ret = ::syscall(SYS_newfstatat, fd, path, statbuf, flags);
+#else
+	auto ret = ::syscall(SYS_fstatat64, fd, path, statbuf, flags);
+#endif
+	if(int e = sc_error(ret); e)
+		return e;
+	return 0;
+}
